# ============================================================
# OPTIBASE — .gitignore raiz del monorepo
# ============================================================

# --- Credenciales y configuracion local (NUNCA al repo) ---
**/application-local.properties
**/application-dev.properties
# application-prod.properties NO se excluye: usa solo ${VAR} sin valores reales
# y debe estar en el repo para que la imagen Docker de Railway pueda cargarlo.
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.*.local

# --- Backups de base de datos ---
scripts/backups/*.sql

# ============================================================
# Java / Maven (backDevelop)
# ============================================================
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/
*.code-workspace

# ============================================================
# Node / Angular (frontDevelop)
# ============================================================
node_modules/
dist/
.angular/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# Angular SSR
.angular/cache

# ============================================================
# Sistema operativo
# ============================================================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# Claude Code
# ============================================================
.claude/
